{
  "name": "cloudflare-chat-portfolio",
  "compatibility_date": "2025-04-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "main": "./worker/index.ts",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "vars": {
    "TO_EMAIL": "chat@chatsumlin.com",
    "FROM_EMAIL": "No Reply <send@chatsumlin.com>",
    "VITE_HCAPTCHA_SITE_KEY": "0634de9a-f938-4d5c-83b0-2066bae4ef72",
  },
}
