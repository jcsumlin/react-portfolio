{
  "name": "cloudflare-chat-portfolio",
  "compatibility_date": "2025-04-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "main": "./worker/index.ts"
}
